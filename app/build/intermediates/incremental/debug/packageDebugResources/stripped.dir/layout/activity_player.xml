<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A14">

    <!-- 1. TELA DE LOADING (Carregando Lista M3U) -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FF0A0A14"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/progressBarPlayer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="#FF6366F1" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carregando lista M3U..."
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tvLoadingSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processando canais, filmes e séries..."
            android:textColor="#88FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/btnRetryLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Tentar Novamente"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/tab_selector"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginTop="24dp"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 2. DASHBOARD / MENU PRINCIPAL (Canais, Filmes, Séries) -->
    <LinearLayout
        android:id="@+id/layoutDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <!-- Header Dashboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📺 FSTV PLAYER"
                android:textColor="#FF6366F1"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cliente"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp"
                android:background="#1AFFFFFF"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolha o que deseja assistir:"
            android:textColor="#AAFFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- 3 CARDS DO MENU PRINCIPAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Card 1: CANAIS AO VIVO -->
            <LinearLayout
                android:id="@+id/cardLiveTv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_selector"
                android:gravity="center"
                android:padding="24dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Canais ao Vivo"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvLiveTvCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 canais"
                    android:textColor="#AAFFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Card 2: FILMES -->
            <LinearLayout
                android:id="@+id/cardMovies"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_selector"
                android:gravity="center"
                android:padding="24dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filmes"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvMoviesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 filmes"
                    android:textColor="#AAFFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Card 3: SÉRIES -->
            <LinearLayout
                android:id="@+id/cardSeries"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_selector"
                android:gravity="center"
                android:padding="24dp"
                android:focusable="true"
                android:clickable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎭"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Séries"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvSeriesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 séries"
                    android:textColor="#AAFFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 3. TELA DE CONTEÚDO (Player + Sidebar de Categorias Vertical) -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Barra Superior com Botão INÍCIO Destacado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="#CC0A0A14"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Botão 🏠 INÍCIO (Volta Direto ao Menu Principal) -->
            <TextView
                android:id="@+id/btnHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠 INÍCIO"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/tab_selector"
                android:focusable="true"
                android:clickable="true" />

            <!-- Botão ← Voltar -->
            <TextView
                android:id="@+id/btnBackToDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Voltar"
                android:textColor="#FF818CF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/tab_selector"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/tvSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📡 Canais ao Vivo"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="240dp"
                android:layout_height="38dp"
                android:background="#1AFFFFFF"
                android:hint="🔍 Pesquisar..."
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- SIDEBAR VERTICAL DE CATEGORIAS / TEMPORADAS (Esquerda) -->
            <LinearLayout
                android:id="@+id/sidebarCategories"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#DD0D0D1F">

                <TextView
                    android:id="@+id/tvSidebarHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CATEGORIAS"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:padding="12dp"
                    android:background="#1AFFFFFF" />

                <!-- LISTA VERTICAL DE CATEGORIAS / TEMPORADAS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp" />

            </LinearLayout>

            <!-- LISTA/GRADE DE CONTEÚDO (Canais/Filmes/Episódios) -->
            <LinearLayout
                android:id="@+id/sidebarChannels"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#CC0A0A14">

                <TextView
                    android:id="@+id/tvCategoryHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ITENS DA CATEGORIA"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:padding="12dp"
                    android:background="#1AFFFFFF" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChannels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp" />

            </LinearLayout>

            <!-- ÁREA PRINCIPAL DE VÍDEO (Player) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#FF000000">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true" />

                <!-- Overlay de Informações do Canal -->
                <LinearLayout
                    android:id="@+id/channelInfoOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#CC000000"
                    android:padding="16dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCurrentChannelName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FF818CF8"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
