<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_blue">#38BDF8</color>
    <color name="accent_gold">#F59E0B</color>
    <color name="bg_dark">#0F172A</color>
    <color name="btn_bg">#0284C7</color>
    <color name="btn_focus">#38BDF8</color>
    <color name="card_bg">#1E293B</color>
    <color name="text_muted">#94A3B8</color>
    <color name="text_white">#F8FAFC</color>
    <string name="app_name">Fstv-Player</string>
    <style name="Theme.FstvPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>
    <style name="Theme.FstvPlayer.Fullscreen" parent="Theme.FstvPlayer">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>