<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#FF0A0A14">

    <!-- SIDEBAR ESQUERDA: Categorias + Lista de canais -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#CC0D0D1F"
        android:visibility="gone">

        <!-- Header com nome do cliente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="#1A6366F1"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📺 Fstv Player"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCustomerWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cliente"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Abas de categorias: Canais / Filmes / Séries -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp" />

        </HorizontalScrollView>

        <!-- Barra de busca rápida -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:background="#1AFFFFFF"
            android:hint="🔍 Buscar canal..."
            android:textColorHint="#66FFFFFF"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:padding="10dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <!-- Lista de Canais -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </LinearLayout>

    <!-- ÁREA PRINCIPAL: Player -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- Player de vídeo -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true" />

        <!-- Loading overlay -->
        <LinearLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#CC0A0A14">

            <ProgressBar
                android:id="@+id/progressBarPlayer"
                android:layout_width="64dp"
                android:layout_height="64dp" />

            <TextView
                android:id="@+id/tvLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carregando canais..."
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="16dp" />

        </LinearLayout>

        <!-- Indicador de canal atual (aparece brevemente ao trocar) -->
        <LinearLayout
            android:id="@+id/channelInfoOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#CC000000"
            android:padding="16dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCurrentChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#996366F1"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Botão para abrir/fechar sidebar (D-pad: botão MENU ou Back) -->
        <TextView
            android:id="@+id/btnToggleSidebar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="☰"
            android:textSize="20sp"
            android:textColor="#FFFFFFFF"
            android:gravity="center"
            android:background="#996366F1"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:focusable="true"
            android:clickable="true" />

    </FrameLayout>

</LinearLayout>
