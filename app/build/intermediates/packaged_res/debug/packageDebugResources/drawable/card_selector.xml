<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF6366F1"
                android:endColor="#FF4F46E5"
                android:angle="135" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF4F46E5"
                android:endColor="#FF4338CA"
                android:angle="135" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1F6366F1"
                android:endColor="#0F4F46E5"
                android:angle="135" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#336366F1" />
        </shape>
    </item>
</selector>
