<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focado (D-pad Controle Remoto) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF6366F1"
                android:endColor="#FF4F46E5"
                android:angle="45" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <!-- Selecionado (Categoria Ativa) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#CC4F46E5"
                android:endColor="#CC4338CA"
                android:angle="45" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FF818CF8" />
        </shape>
    </item>
    <!-- Pressionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF4338CA" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
